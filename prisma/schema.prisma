generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Tipo {
  USER
  ADMIN
}

enum Status {
  ATIVO
  INATIVO
}

enum Plan {
  BASICO
  INTERMEDIARIO
  AVANCADO
  ADMIN
}

enum Throw {
  ENTRADA
  SAIDA
}

enum Process {
  PROCESSANDO
  PROCESSADO
}

enum Cax {
  ABERTA
  FECHADA
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  tipo      Tipo @default(USER)
  status    Status @default(ATIVO)
  planoUser Plan @default(BASICO)
  entradaPrincipal Float 
  createdAt DateTime @default(now())
}

model Conta {
  idConta Int   @id @default(autoincrement())
  saldo   Float
}

model Agendado {
  idAgenda  Int    @id @default(autoincrement())
  descricao String
  previsao  Float 
  periodo   Int   
  valor     Float
}

model Lancamento {
  idLaunch        Int      @id @default(autoincrement())
  valor           Float    
  tipoLaunch      Throw
  descricaoLaunch String
  data            DateTime @default(now())
  statusLaunch    Process  @default(PROCESSANDO)
}

model Orcamento {
  idOrc  Int @id @default(autoincrement())
  mes    Float
  limite Float
}

model Service {
  idServ     Int @id @default(autoincrement())
  nameServ   String
  preco      Float
  beneficios String
  @@map("servico")
}

model Caixinha {
  idCaixa Int @id @default(autoincrement())
  meta String
  alvo Float
  caixa Cax
  valorMove Float
  move Throw
}