generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Tipo {
  USER
  ADMIN
}

enum Status {
  ATIVO
  INATIVO
}

enum Plan {
  BASICO
  INTERMEDIARIO
  AVANCADO
  ADMIN
}

enum Throw {
  ENTRADA
  SAIDA
}

enum Process {
  PROCESSANDO
  PROCESSADO
}

enum Cax {
  ABERTA
  FECHADA
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  tipo      Tipo @default(USER)
  status    Status @default(ATIVO)
  planoUser Plan @default(BASICO)
  createdAt DateTime @default(now())
  contas Conta[]
  operacoes Lancamento[]
  entradas Entrada[]
  caixa Caixinha[]
}

model Entrada {
  idEntrada    Int @id @default(autoincrement())
  valorInicial Float
  tipoConta      Throw
  criado DateTime @default(now())
  dataResgate DateTime
  finalizado Boolean @default(false)
  userId Int
  user User @relation(fields: [userId], references: [id])
  contaId Int
  conta Conta @relation(fields: [contaId], references: [idConta])
}

model Conta {
  idConta Int   @id @default(autoincrement())
  saldo   Float
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
  enter Entrada[]
  payment Lancamento[]
}

model Lancamento {
  idLaunch        Int      @id @default(autoincrement())
  valor           Float    
  tipoLaunch      Throw
  descricaoLaunch String
  data            DateTime @default(now())
  statusLaunch    Process  
  userId Int
  user User @relation(fields: [userId], references: [id])
  contaId Int
  conta Conta @relation(fields: [contaId], references: [idConta])
}

model Service {
  idServ     Int @id @default(autoincrement())
  nameServ   String
  preco      Float
  beneficios String
  @@map("servico")
}

model Caixinha {
  idCaixa Int @id @default(autoincrement())
  meta String
  alvo Float
  caixa Cax
  valorMove Float
  move Throw
  userId Int
  user User @relation(fields: [userId], references: [id])
}